   "source": [
    "start_time = time.time()\n",
    "\n",
    "def convert_table_to_gdb():\n",
    "    # Allows to be overwritten\n",
    "    arcpy.env.overwriteOutput = True\n",
    "\n",
    "    # CSV path and Geodatabase path\n",
    "    csv_table = os.path.join(path_agol, data_source, indicator_name, indicator_name + '.csv')\n",
    "    geodatabase = \"I:\\\\Monitoring and Reporting\\\\PublishTables\\\\Default.gdb\"\n",
    "\n",
    "    # Converison\n",
    "    arcpy.conversion.TableToGeodatabase(Input_Table=[csv_table], Output_Geodatabase=geodatabase)\n",
    "\n",
    "    print(\"Table has been successfully converted to Geodatabase format.\")\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    convert_table_to_gdb()\n",
    "\n",
    "print(f\"Process complete.  It took --- {round((time.time() - start_time)/60, 1)} minutes ---  ^_^..V..\")"
